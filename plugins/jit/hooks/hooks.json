{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "mcp__.+__create_pull_request",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/scripts/jit.js\" hook"
          }
        ]
      },
      {
        "matcher": "Write|Edit|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/scripts/jit.js\" guard"
          }
        ]
      }
    ]
  }
}
